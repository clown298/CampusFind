# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env (it is git-ignored).

# --- Database (option A): local PostgreSQL with individual settings ---
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=5432
# Set DB_SSL=true only if your local database requires an encrypted connection.
# DB_SSL=true

# --- Database (option B): managed/production PostgreSQL connection string ---
# When DATABASE_URL is set it is used instead of the DB_* variables above.
# Managed providers such as Neon require TLS; include ?sslmode=require in the
# URL, for example:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- App ---
# Port the backend listens on. Set by the hosting provider in production.
PORT=5000

# Secret used to sign session tokens. Use a long random string in production.
JWT_SECRET=

# Allowed frontend origin for CORS (the deployed frontend URL in production).
# If the backend serves the built frontend from the same origin, CORS is not needed.
CORS_ORIGIN=http://localhost:5173

# Set to production only when deployed. Enables secure cookies and trust of
# the single reverse-proxy hop used for correct client-IP rate limiting.
# The frontend is served separately (Vercel); this backend only serves the API.
NODE_ENV=development

# --- Accounts ---
# Exact email that owns the admin account. Registration by this email creates
# the admin; tests override it with a throwaway address.
#
# To change the admin email safely:
#   1. Have the new admin register an account at the app (or use --create below).
#   2. Run:  node scripts/provision-admin.js --apply
#            (add --create if the account does not exist yet)
#   3. Update ADMIN_EMAIL below to match the new admin email.
#   4. The old admin account is demoted to "student" — all its items and records
#      are preserved. The account is NOT deleted.
#
# Dry-run inspection (no DB changes):
#   node scripts/provision-admin.js
ADMIN_EMAIL=nayeemaalma@gmail.com

# Comma-separated emails that are given the staff role at registration.
# Staff review recovery requests only when they also hold that permission
# (see PERMISSIONS.md and the provisioning script).
# STAFF_EMAILS=staff1@campus.edu,staff2@campus.edu