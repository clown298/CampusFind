# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env (it is git-ignored).

# --- Database (option A): local PostgreSQL with individual settings ---
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=5432
# Set DB_SSL=true only if your local database requires an encrypted connection.
# DB_SSL=true

# --- Database (option B): managed/production PostgreSQL connection string ---
# When DATABASE_URL is set it is used instead of the DB_* variables above,
# and SSL is enabled automatically in production.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# --- App ---
# Port the backend listens on. Set by the hosting provider in production.
PORT=5000

# Secret used to sign session tokens. Use a long random string in production.
JWT_SECRET=

# Allowed frontend origin for CORS (the deployed frontend URL in production).
# If the backend serves the built frontend from the same origin, CORS is not needed.
CORS_ORIGIN=http://localhost:5173

# Set to production only when deployed. Enables secure cookies, SSL for
# DATABASE_URL, and static serving of the built frontend.
NODE_ENV=development